# Public (shipped to the browser) - never put secrets here.
# Base URL of the API. "/api" uses the Vite dev proxy / the nginx reverse proxy (recommended).
# An absolute URL such as http://localhost:8080/api requires CORS_ALLOWED_ORIGINS on the backend
# and a cookie SameSite policy that fits your deployment.
VITE_API_URL=/api
# Dev-server proxy target (read by vite.config.ts, not exposed to the browser)
VITE_DEV_PROXY_TARGET=http://localhost:8080
