# Copy to .env and replace every placeholder. .env is git-ignored - never commit real secrets.

# --- Database ---
DB_NAME=store_inventory
DB_USERNAME=store
DB_PASSWORD=change-me-use-a-long-random-password

# --- JWT (REQUIRED). Base64, >= 32 bytes decoded.  Generate with:  openssl rand -base64 48
JWT_SECRET=
JWT_ISSUER=store-inventory
JWT_ACCESS_TTL=PT15M
REFRESH_TOKEN_TTL=P7D

# --- Cookies / CORS ---
# true when served over HTTPS (production). false only for plain-http local development.
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- First store-manager account (created on startup if it does not exist) ---
# DEVELOPMENT PLACEHOLDERS ONLY - choose your own email and a strong password (12-72 chars).
# Remove MANAGER_PASSWORD from the environment once the account exists.
MANAGER_EMAIL=manager@example.com
MANAGER_PASSWORD=
MANAGER_NAME="Store Manager"

# --- Ports ---
FRONTEND_PORT=3000
BACKEND_PORT=8080
DB_PORT=5432
